Blind.BadEvolveState:evolve/2 [infer, 2 clause(s), domain set]
    (%{..., nmae: term()}, %Blind.Account.Event.Renamed{payload: %{..., name: term()}} -> dynamic(%{..., nmae: term()}))
    (term(), %Blind.Account.Event.Closed{} or %Blind.Account.Event.Opened{} -> dynamic())
Blind.BadProjection:project/1 [infer, 2 clause(s), domain set]
    (%Blind.Account.Event.Opened{payload: %{..., nmae: term()}} or
