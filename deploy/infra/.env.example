COMPOSE_PROJECT_NAME=core-infra

# PostgreSQL — образ ожидает эти имена переменных как есть
POSTGRES_USER=core
POSTGRES_PASSWORD=core
POSTGRES_DB=core
# Порты разведены с инфрой приложений-потребителей: стеки должны уметь
# работать одновременно (config/test.exs читает те же значения из окружения).
POSTGRES_PORT=5433

# RabbitMQ — образ ожидает RABBITMQ_DEFAULT_USER/RABBITMQ_DEFAULT_PASS
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_STREAM_PORT=5553
