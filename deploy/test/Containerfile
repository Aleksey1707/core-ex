# syntax=docker/dockerfile:1

# Toolchain-образ для `make test`: mix test в контейнере с сетью хоста, видит
# Postgres/RabbitMQ из ../infra/compose.yml по localhost. Исходники не копируются —
# репозиторий монтируется volume'ом в /app (см. Makefile).

ARG ELIXIR_VERSION=1.20.3
ARG OTP_VERSION=29.0.5
ARG ALPINE_VERSION=3.24.1
ARG BUILDER_IMAGE="docker.io/hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-alpine-${ALPINE_VERSION}"

FROM ${BUILDER_IMAGE}

RUN apk add --no-cache build-base cmake git

RUN mix local.hex --force \
  && mix local.rebar --force

WORKDIR /app
