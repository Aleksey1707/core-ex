{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "External calls by system: rate, error share and duration (Core.External.PromEx)",
  "editable": false,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "External calls per second over the selected systems by outcome",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\", system=~\"$system\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Calls by outcome",
      "type": "stat"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Share of calls not ending ok over the selected systems",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "sum(rate(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\", system=~\"$system\", outcome!=\"ok\"}[5m])) / clamp_min(sum(rate(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\", system=~\"$system\"}[5m])), 1e-9)",
          "legendFormat": "error share",
          "refId": "A"
        }
      ],
      "title": "Error share",
      "type": "stat"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "p95 of external call duration over the selected systems",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "<%= @external_duration_axis_unit %>",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(<%= @external_metric_prefix %>_call_duration_<%= @external_duration_unit %>_bucket{job=\"$job\", instance=\"$instance\", system=~\"$system\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "Call duration p95",
      "type": "stat"
    },
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 101,
      "panels": [],
      "title": "Calls",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "External calls per second by system, operation and outcome (Core.External.call/4); each retry is its own call",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "id": 1,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (system, operation, outcome) (rate(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\", system=~\"$system\"}[5m]))",
          "legendFormat": "{{system}} {{operation}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Call rate",
      "type": "timeseries"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Share of calls not ending ok by system and operation: timeout, down, rejected or exception (ExternalCallFailing)",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 2,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (system, operation) (rate(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\", system=~\"$system\", outcome!=\"ok\"}[5m])) / clamp_min(sum by (system, operation) (rate(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\", system=~\"$system\"}[5m])), 1e-9)",
          "legendFormat": "{{system}} {{operation}}",
          "refId": "A"
        }
      ],
      "title": "Error share",
      "type": "timeseries"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "p95 of external call duration by system and operation (ExternalCallSlow)",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "<%= @external_duration_axis_unit %>"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 3,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, system, operation) (rate(<%= @external_metric_prefix %>_call_duration_<%= @external_duration_unit %>_bucket{job=\"$job\", instance=\"$instance\", system=~\"$system\"}[5m])))",
          "legendFormat": "p95 {{system}} {{operation}}",
          "refId": "A"
        }
      ],
      "title": "Call duration p95",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 26,
  "style": "dark",
  "tags": [
    "PromEx",
    "External",
    "<%= @otp_app %>"
  ],
  "templating": {
    "list": [
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus Job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 6,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      },
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "Application Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\"}, system)",
        "hide": 0,
        "includeAll": true,
        "label": "System",
        "multi": true,
        "name": "system",
        "options": [],
        "query": "label_values(<%= @external_metric_prefix %>_call_total{job=\"$job\", instance=\"$instance\"}, system)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "",
  "title": "<%= @title %>",
  "uid": "<%= @uid %>",
  "version": 1
}
