{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Container memory (Core.Cgroup.PromEx): anon — the application's own memory, page cache excluded; current — memory.current with page cache; limit — memory.max, absent without a limit",
  "editable": false,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Container memory",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "cgroup memory.stat anon: the application's own memory, page cache excluded (Core.Cgroup.PromEx)",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": <%= @container_memory_warning %>
              },
              {
                "color": "red",
                "value": <%= @container_memory_critical %>
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_anon_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "anon",
          "refId": "A"
        }
      ],
      "title": "Container memory (anon)",
      "type": "stat"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Container memory (Core.Cgroup.PromEx): current — memory.current with page cache; anon — memory.stat anon, the application's own memory; limit — memory.max, absent without a limit",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_current_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "current",
          "refId": "A"
        },
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_anon_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "anon",
          "refId": "B"
        },
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_max_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "limit",
          "refId": "C"
        }
      ],
      "title": "Container memory over time",
      "type": "timeseries"
    }
  ],
  "refresh": "<%= @dashboard_refresh %>",
  "schemaVersion": 26,
  "style": "dark",
  "tags": [
    "PromEx",
    "Container",
    "<%= @otp_app %>"
  ],
  "templating": {
    "list": [
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus Job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 6,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      },
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "Application Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "",
  "title": "<%= @title %>",
  "uid": "<%= @uid %>",
  "version": 1
}
