{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Critical OTP workers: up, mailbox length, memory (Core.Workers.PromEx); container memory (Core.Cgroup.PromEx); metric collection failures of all Core.*.PromEx plugins (Core.PromEx.Safe)",
  "editable": false,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Down: watched processes that are not alive now (alert WorkerDown); Total: processes under watch",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "count(<%= @workers_metric_prefix %>_up{job=\"$job\", instance=\"$instance\"} == 0) or vector(0)",
          "legendFormat": "Down",
          "refId": "A"
        },
        {
          "expr": "count(<%= @workers_metric_prefix %>_up{job=\"$job\", instance=\"$instance\"})",
          "legendFormat": "Total",
          "refId": "B"
        }
      ],
      "title": "Workers",
      "type": "stat"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "1 = DOWN, 0 = UP for every watched process; the tooltip lists only processes DOWN at the hovered moment",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "stepAfter"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                }
              }
            }
          ],
          "min": 0,
          "max": 1,
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      },
      "targets": [
        {
          "expr": "1 - <%= @workers_metric_prefix %>_up{job=\"$job\", instance=\"$instance\", component=~\"$component\"}",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "title": "Workers down",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 101,
      "panels": [],
      "title": "Mailbox / Memory",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Process mailbox length by component",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "locale"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 2,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "<%= @workers_metric_prefix %>_message_queue_len{job=\"$job\", instance=\"$instance\", component=~\"$component\"}",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "title": "Mailbox length",
      "type": "timeseries"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Process memory by component",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 3,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "<%= @workers_metric_prefix %>_memory_bytes{job=\"$job\", instance=\"$instance\", component=~\"$component\"}",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "title": "Memory",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 102,
      "panels": [],
      "title": "Container",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "cgroup memory.current: container RAM as the OS sees it, page cache included (Core.Cgroup.PromEx)",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": <%= @workers_container_memory_warning %>
              },
              {
                "color": "red",
                "value": <%= @workers_container_memory_critical %>
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 25
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_current_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "container",
          "refId": "A"
        }
      ],
      "title": "Container memory",
      "type": "stat"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Container memory (Core.Cgroup.PromEx): current — memory.current with page cache; anon — memory.stat anon, the application's own memory; limit — memory.max, absent without a limit",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 25
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_current_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "current",
          "refId": "A"
        },
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_anon_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "anon",
          "refId": "B"
        },
        {
          "expr": "<%= @cgroup_metric_prefix %>_memory_max_bytes{job=\"$job\", instance=\"$instance\"}",
          "legendFormat": "limit",
          "refId": "C"
        }
      ],
      "title": "Container memory over time",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 103,
      "panels": [],
      "title": "Metric collection",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Failed PromEx polling cycles per second by group across Core.*.PromEx plugins (Core.PromEx.Safe): while a group fails, its gauges freeze on the last value (PromExCollectFailing)",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (collector) (rate({__name__=~\"<%= @workers_collect_errors_pattern %>\", job=\"$job\", instance=\"$instance\"}[5m]))",
          "legendFormat": "{{collector}}",
          "refId": "A"
        }
      ],
      "title": "Collect errors by collector",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 26,
  "style": "dark",
  "tags": [
    "PromEx",
    "Workers",
    "<%= @otp_app %>"
  ],
  "templating": {
    "list": [
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus Job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 6,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      },
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "Application Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @workers_metric_prefix %>_up{job=\"$job\", instance=\"$instance\"}, component)",
        "hide": 0,
        "includeAll": true,
        "label": "Component",
        "multi": true,
        "name": "component",
        "options": [],
        "query": "label_values(<%= @workers_metric_prefix %>_up{job=\"$job\", instance=\"$instance\"}, component)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "",
  "title": "<%= @title %>",
  "uid": "<%= @uid %>",
  "version": 1
}
