{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Application caches: hit ratio, size, errors (Core.Cache.PromEx)",
  "editable": false,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Hit share among hit / miss / expired of the worst cache with requests; which one — panel Hit ratio",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": <%= @cache_hit_ratio_critical %>
              },
              {
                "color": "green",
                "value": <%= @cache_hit_ratio_warning %>
              }
            ]
          },
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "min(sum by (cache) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\", result=\"hit\"}[5m])) / (sum by (cache) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\", result=~\"hit|miss|expired\"}[5m])) > 0))",
          "legendFormat": "min hit ratio",
          "refId": "A"
        }
      ],
      "title": "Hit ratio (5m, min)",
      "type": "stat"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Entries in all caches; per cache — panel Cache size",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "locale",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 20
        }
      },
      "pluginVersion": "7.1.3",
      "targets": [
        {
          "expr": "sum(<%= @cache_metric_prefix %>_size{job=\"$job\", instance=\"$instance\"})",
          "legendFormat": "entries",
          "refId": "A"
        }
      ],
      "title": "Cache size (total)",
      "type": "stat"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Requests per second by result, summed over caches",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 7,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "Request rate (all caches)",
      "type": "timeseries"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Cache and store errors per second, summed over caches",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 8,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\", result=~\"cache_error|store_error\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "title": "Error rate (all caches)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 101,
      "panels": [],
      "title": "Requests",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Cache requests per second by result",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 3,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (cache, result) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\", cache=~\"$cache\"}[5m]))",
          "legendFormat": "{{cache}} {{result}}",
          "refId": "A"
        }
      ],
      "title": "Request rate by result",
      "type": "timeseries"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Hit share among hit / miss / expired per cache",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 4,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (cache) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\", cache=~\"$cache\", result=\"hit\"}[5m])) / (sum by (cache) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\", cache=~\"$cache\", result=~\"hit|miss|expired\"}[5m])) > 0)",
          "legendFormat": "{{cache}}",
          "refId": "A"
        }
      ],
      "title": "Hit ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "datasource": null,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 102,
      "panels": [],
      "title": "Size / Errors",
      "type": "row"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Entries in the cache",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "locale",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 5,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "<%= @cache_metric_prefix %>_size{job=\"$job\", instance=\"$instance\", cache=~\"$cache\"}",
          "legendFormat": "{{cache}}",
          "refId": "A"
        }
      ],
      "title": "Cache size",
      "type": "timeseries"
    },
    {
      "datasource": "<%= @datasource_id %>",
      "description": "Errors of the cache and of the underlying store per second",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 6,
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (cache, result) (rate(<%= @cache_metric_prefix %>_requests_total{job=\"$job\", instance=\"$instance\", cache=~\"$cache\", result=~\"cache_error|store_error\"}[5m]))",
          "legendFormat": "{{cache}} {{result}}",
          "refId": "A"
        }
      ],
      "title": "Error rate",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 26,
  "style": "dark",
  "tags": [
    "PromEx",
    "Cache",
    "<%= @otp_app %>"
  ],
  "templating": {
    "list": [
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus Job",
        "multi": false,
        "name": "job",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info, job)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 6,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      },
      {
        "allValue": null,
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "hide": 0,
        "includeAll": false,
        "label": "Application Instance",
        "multi": false,
        "name": "instance",
        "options": [],
        "query": "label_values(<%= @prom_ex_metric_prefix %>_status_info{job=\"$job\"}, instance)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": "<%= @datasource_id %>",
        "definition": "label_values(<%= @cache_metric_prefix %>_size{job=\"$job\", instance=\"$instance\"}, cache)",
        "hide": 0,
        "includeAll": true,
        "label": "Cache",
        "multi": true,
        "name": "cache",
        "options": [],
        "query": "label_values(<%= @cache_metric_prefix %>_size{job=\"$job\", instance=\"$instance\"}, cache)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "tagValuesQuery": "",
        "tags": [],
        "tagsQuery": "",
        "type": "query",
        "useTags": false
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "",
  "title": "<%= @title %>",
  "uid": "<%= @uid %>",
  "version": 1
}
